# Copy this file to .env.local for development. It is ignored by Git.
# Paste the _local Google Forms RESPONDER link after the equals sign.
VITE_REGISTRATION_FORM_URL_LOCAL=

# Set this separately in the FRONTEND host's Production environment.
# Paste the _prod responder link. The current frontend host is Vercel.
VITE_REGISTRATION_FORM_URL_PROD=

# Never use Google Docs, response Sheet, or organiser/edit URLs here.
# The old VITE_REGISTRATION_FORM_URL variable is no longer read.
