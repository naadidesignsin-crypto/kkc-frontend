# Local Google Forms responder link (existing fallback)
VITE_REGISTRATION_FORM_URL_LOCAL=
# Optional styled Apps Script /exec URL; takes precedence over FORM_URL.
VITE_REGISTRATION_WEBAPP_URL_LOCAL=

# Configure separately in the frontend host Production environment.
VITE_REGISTRATION_FORM_URL_PROD=
VITE_REGISTRATION_WEBAPP_URL_PROD=

# Public responder or /exec URLs only; no organiser/edit/Sheet URLs.
# Copy to .env.local for testing. .env.local is ignored by Git.
